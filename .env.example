# Postgres connection string.
# Railway injects this automatically from the Postgres service.
DATABASE_URL=

# Stripe. Both are required before any bid can be taken.
# Secret key:     Stripe dashboard > Developers > API keys
# Webhook secret: Stripe dashboard > Developers > Webhooks > your endpoint,
#                 which must point at https://<your-domain>/api/stripe/webhook
#                 and send the checkout.session.completed event.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
